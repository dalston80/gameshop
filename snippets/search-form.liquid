{% doc %}
  Renders the search form with predictive search results.

  @param {string} id - Unique id prefix for this instance

  @example
  {% render 'search-form', id: 'header-search' %}
{% enddoc %}

<predictive-search class="search-form">
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="{{ id }}-input">{{ 'general.search.label' | t }}</label>
    <div class="search-form__field">
      <input
        id="{{ id }}-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        autocomplete="off"
        aria-expanded="false"
        aria-controls="{{ id }}-results"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="search-form__submit" aria-label="{{ 'general.search.submit' | t }}">
        {% render 'icon', name: 'search' %}
      </button>
    </div>
    <div id="{{ id }}-results" class="search-form__results" data-predictive-results hidden></div>
  </form>
</predictive-search>

{% stylesheet %}
  .search-form {
    position: relative;
    display: block;
    color: var(--color-text);
  }

  .search-form__field {
    display: flex;
  }

  .search-form__field input[type='search'] {
    flex: 1;
    border-color: transparent;
    border-radius: var(--radius) 0 0 var(--radius);
  }

  .search-form__field input[type='search']::-webkit-search-cancel-button {
    appearance: none;
  }

  .search-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    border: 0;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-accent);
    color: var(--color-on-accent);
    cursor: pointer;
  }

  .search-form__results {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 0.25rem);
    z-index: 40;
    max-height: 70vh;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-background);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.15);
  }
{% endstylesheet %}
