{%- liquid
  assign image = section.settings.image
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign focal_style = 'object-position: ' | append: image.presentation.focal_point
-%}

<div class="image-banner image-banner--{{ section.settings.height }}{% if image == blank %} image-banner--empty{% endif %}">
  <div class="image-banner__media">
    {%- if image != blank -%}
      {%- if section.index == 1 -%}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'image-banner__image',
            style: focal_style
        }}
      {%- else -%}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            loading: 'lazy',
            class: 'image-banner__image',
            style: focal_style
        }}
      {%- endif -%}
      <div class="image-banner__overlay" style="--overlay-opacity: {{ overlay }}"></div>
    {%- elsif request.design_mode -%}
      {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg image-banner__image' }}
    {%- endif -%}
  </div>

  {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
    <div class="image-banner__content page-width">
      <div class="image-banner__text image-banner__text--{{ section.settings.text_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="image-banner__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="image-banner__subtext">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .image-banner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 16rem;
    background: var(--color-primary);
    color: #fff;
  }

  .image-banner--empty {
    color: var(--color-on-primary);
  }

  .image-banner--medium {
    min-height: 22rem;
  }

  .image-banner--large {
    min-height: 28rem;
  }

  @media (min-width: 750px) {
    .image-banner {
      min-height: 22rem;
    }

    .image-banner--medium {
      min-height: 30rem;
    }

    .image-banner--large {
      min-height: 40rem;
    }
  }

  .image-banner__media {
    position: absolute;
    inset: 0;
  }

  .image-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--overlay-opacity, 0.5));
  }

  .image-banner__content {
    position: relative;
    z-index: 1;
    padding-block: 3rem;
  }

  .image-banner__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 38rem;
  }

  .image-banner__text--center {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .image-banner__text--right {
    align-items: flex-end;
    margin-inline-start: auto;
    text-align: end;
  }

  .image-banner__heading,
  .image-banner__subtext {
    margin: 0;
  }

  .image-banner__heading {
    font-size: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
  }

  .image-banner__subtext {
    font-size: 1.125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.image_banner.name",
  "tag": "section",
  "class": "section-image-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_banner.settings.image.label"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.image_banner.settings.height.label",
      "options": [
        { "value": "small", "label": "t:sections.image_banner.settings.height.small" },
        { "value": "medium", "label": "t:sections.image_banner.settings.height.medium" },
        { "value": "large", "label": "t:sections.image_banner.settings.height.large" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.image_banner.settings.overlay_opacity.label",
      "info": "t:sections.image_banner.settings.overlay_opacity.info",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_banner.settings.heading.label",
      "default": "Image banner"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.image_banner.settings.text.label",
      "default": "Give customers details about a banner image or promotion."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_banner.settings.button_label.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_banner.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.image_banner.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.image_banner.settings.text_alignment.left" },
        { "value": "center", "label": "t:sections.image_banner.settings.text_alignment.center" },
        { "value": "right", "label": "t:sections.image_banner.settings.text_alignment.right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_banner.presets.name"
    }
  ]
}
{% endschema %}
