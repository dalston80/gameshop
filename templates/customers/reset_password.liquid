{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer customer--narrow page-width">
  <h1 class="customer__title">{{ 'customer.reset_password.title' | t }}</h1>
  <p>{{ 'customer.reset_password.subtext' | t }}</p>

  {%- form 'reset_customer_password', novalidate: 'novalidate', class: 'customer__form' -%}
    {% render 'customer-form-errors', form: form %}

    <div class="field">
      <label for="reset-password">{{ 'customer.fields.password' | t }}</label>
      <input
        id="reset-password"
        type="password"
        name="customer[password]"
        autocomplete="new-password"
        required
        {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
      >
    </div>

    <div class="field">
      <label for="reset-password-confirmation">{{ 'customer.fields.password_confirmation' | t }}</label>
      <input
        id="reset-password-confirmation"
        type="password"
        name="customer[password_confirmation]"
        autocomplete="new-password"
        required
        {% if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}
      >
    </div>

    <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>
