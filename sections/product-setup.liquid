{%- liquid
  assign max_items = section.settings.max_items
  assign override_items = product.metafields.custom.setup_items.value
  assign companions = blank
  assign should_fetch = false

  if override_items != blank
    assign companions = override_items
  elsif recommendations.performed
    assign companions = recommendations.products
  elsif product.available
    assign should_fetch = true
  endif

  assign shown = 0
  assign total_cents = product.selected_or_first_available_variant.price
  capture companion_items
    for companion in companions
      if companion == blank or companion.id == product.id
        continue
      endif
      if shown >= max_items
        break
      endif
      assign shown = shown | plus: 1
      if companion.has_only_default_variant and companion.available
        assign total_cents = total_cents | plus: companion.price
      endif
      render 'product-setup-item', product: companion
    endfor
  endcapture
-%}

<product-setup
  class="product-setup"
  {% if should_fetch %}
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ max_items }}&intent=complementary"
  {% endif %}
  data-currency="{{ cart.currency.iso_code }}"
  style="
    --section-padding-top: {{ section.settings.padding_top | divided_by: 16.0 }}rem;
    --section-padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.0 }}rem;
  "
>
  {%- if should_fetch == false -%}
    {%- if companion_items != blank and product.available -%}
      <div class="section">
        <div class="page-width">
          <div class="product-setup__card">
            {%- if section.settings.heading != blank -%}
              <h2 class="product-setup__heading" id="product-setup-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
            {%- endif -%}

            <ul
              class="product-setup__list"
              role="list"
              {% if section.settings.heading != blank %}
                aria-labelledby="product-setup-heading-{{ section.id }}"
              {% else %}
                aria-label="{{ 'products.setup.list_label' | t }}"
              {% endif %}
            >
              {%- render 'product-setup-item', product: product, is_current: true -%}
              {{- companion_items -}}
            </ul>

            <div class="product-setup__footer">
              <p class="product-setup__total" aria-live="polite" aria-atomic="true">
                <span class="product-setup__total-label">{{ 'products.setup.total' | t }}</span>
                <strong class="product-setup__total-amount" data-setup-total>{{ total_cents | money }}</strong>
              </p>
              <button type="button" class="button product-setup__button" data-setup-add>
                {{- 'products.setup.add_all' | t -}}
              </button>
            </div>
            <p class="product-setup__status" role="status" aria-live="polite" data-setup-status hidden></p>
          </div>
        </div>
      </div>
    {%- elsif request.design_mode -%}
      <div class="section">
        <div class="page-width">
          <p class="product-setup__empty">{{ 'products.setup.empty_editor' | t }}</p>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</product-setup>

<script src="{{ 'product-setup.js' | asset_url }}" defer></script>

{% stylesheet %}
  product-setup {
    display: block;
  }

  product-setup:not(:has(.section)) {
    display: none;
  }

  .product-setup__card {
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-background);
  }

  .product-setup__heading {
    margin: 0 0 1rem;
    font-size: 1.375rem;
  }

  .product-setup__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-setup__item {
    display: grid;
    grid-template-columns: 2.75rem 4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
  }

  .product-setup__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .product-setup__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
  }

  .product-setup__checkbox {
    width: 1.375rem;
    height: 1.375rem;
    margin: 0;
    accent-color: var(--color-primary);
    cursor: inherit;
  }

  .product-setup__checkbox:disabled {
    cursor: not-allowed;
  }

  .product-setup__thumb {
    display: block;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius);
  }

  .product-setup__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    min-width: 0;
  }

  .product-setup__title {
    color: inherit;
    font-weight: var(--font-body-weight-bold);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .product-setup__title:hover {
    text-decoration: underline;
  }

  .product-setup__note {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .product-setup__item .price {
    font-size: 0.9375rem;
  }

  .product-setup__item--sold_out .product-setup__thumb,
  .product-setup__item--sold_out .product-setup__info {
    opacity: 0.6;
  }

  .product-setup__soldout {
    color: var(--color-text-muted);
    font-weight: var(--font-body-weight-bold);
  }

  .product-setup__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .product-setup__total {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .product-setup__total-amount {
    font-size: 1.5rem;
  }

  .product-setup__status {
    margin: 0.75rem 0 0;
    font-weight: var(--font-body-weight-bold);
  }

  .product-setup__status[data-state='error'] {
    color: var(--color-sale);
  }

  .product-setup__status[data-state='success'] {
    color: var(--color-accent-text);
  }

  .product-setup__empty {
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 749px) {
    .product-setup__item {
      grid-template-columns: 2.75rem 3.5rem minmax(0, 1fr);
    }

    .product-setup__thumb {
      width: 3.5rem;
      height: 3.5rem;
    }

    .product-setup__action {
      grid-column: 3;
      justify-self: start;
    }

    .product-setup__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_setup.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_setup.settings.heading.label",
      "default": "Complete your setup"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "t:sections.product_setup.settings.max_items.label",
      "info": "t:sections.product_setup.settings.max_items.info",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.main_product.settings.header_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main_product.settings.padding_top.label",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main_product.settings.padding_bottom.label",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ]
}
{% endschema %}
