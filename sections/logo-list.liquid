{%- liquid
  assign logos = section.blocks | where: 'type', 'logo'
  assign logo_width = section.settings.logo_width
  assign logo_width_2x = logo_width | times: 2
  assign logo_sizes = logo_width | append: 'px'
  assign logo_widths = logo_width | append: ', ' | append: logo_width_2x
  assign has_logo = false
  for block in logos
    if block.settings.image != blank
      assign has_logo = true
    endif
  endfor
-%}

{%- if has_logo or request.design_mode -%}
  <div
    class="section logo-list"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --logo-width: {{ logo_width }}px;"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if logos.size > 0 -%}
        <ul class="logo-list__list" role="list">
          {%- for block in logos -%}
            {%- liquid
              assign image = block.settings.image
              assign link = block.settings.link
              assign alt_text = image.alt
              if alt_text == blank
                assign alt_text = block.settings.name
              endif
            -%}
            {%- if image != blank or request.design_mode -%}
              <li class="logo-list__item" {{ block.shopify_attributes }}>
                {%- if link != blank -%}
                  <a class="logo-list__link" href="{{ link }}">
                {%- endif -%}
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: logo_width_2x
                    | image_tag:
                      widths: logo_widths,
                      sizes: logo_sizes,
                      loading: 'lazy',
                      alt: alt_text,
                      class: 'logo-list__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg logo-list__image logo-list__placeholder' }}
                {%- endif -%}
                {%- if link != blank -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="logo-list__message">{{ 'sections.logo_list.empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .logo-list__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logo-list__item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(var(--logo-width), 40%);
  }

  .logo-list__link {
    display: block;
    width: 100%;
  }

  .logo-list__image {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .logo-list__placeholder {
    aspect-ratio: 3 / 2;
    background: var(--color-soft);
  }

  .logo-list__message {
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (min-width: 750px) {
    .logo-list__item {
      width: var(--logo-width);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.logo_list.name",
  "tag": "section",
  "class": "section-logo-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.logo_list.settings.heading.label",
      "default": "Brand partners"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.logo_list.settings.logo_width.label",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.marketing.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.marketing.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_list.blocks.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.logo_list.blocks.logo.settings.image.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.logo_list.blocks.logo.settings.name.label",
          "info": "t:sections.logo_list.blocks.logo.settings.name.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.logo_list.blocks.logo.settings.link.label"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.logo_list.presets.name",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
