{%- liquid
  assign heading = section.settings.heading
  assign text = section.settings.text
-%}

<div
  class="section newsletter"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="newsletter__inner">
      {%- if heading != blank or text != blank -%}
        <div class="newsletter__text">
          {%- if heading != blank -%}
            <h2 class="newsletter__heading">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if text != blank -%}
            <p class="newsletter__subtext">{{ text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="newsletter__form">
        {% render 'newsletter-form', id: section.id %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .newsletter__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .newsletter__heading {
    margin: 0 0 0.25rem;
    color: var(--color-accent-text);
    font-size: 1.25rem;
  }

  .newsletter__subtext {
    margin: 0;
    color: var(--color-text-muted);
  }

  .newsletter__form {
    width: 100%;
    max-width: 28rem;
  }

  @media (min-width: 750px) {
    .newsletter__inner {
      flex-direction: row;
      justify-content: center;
      text-align: start;
    }

    .newsletter__form {
      flex: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Join our newsletter!"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "Be the first to know about new releases, discounts and more."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.marketing.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.marketing.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name"
    }
  ]
}
{% endschema %}
