{%- liquid
  assign logo = section.settings.logo | default: shop.brand.logo
-%}

<div class="main-password">
  <div class="main-password__card">
    <h1 class="main-password__title">
      {%- if logo != blank -%}
        {%- assign logo_width = section.settings.logo_width -%}
        {%- assign logo_sizes = logo_width | append: 'px' -%}
        {{
          logo
          | image_url: width: 600
          | image_tag:
            widths: '120, 180, 240, 360, 480, 600',
            sizes: logo_sizes,
            width: logo_width,
            loading: 'eager',
            alt: shop.name
        }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </h1>

    {%- if shop.password_message != blank -%}
      <div class="main-password__message rte">{{ shop.password_message }}</div>
    {%- else -%}
      <p class="main-password__message">{{ 'password.opening_soon' | t }}</p>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <section class="main-password__section" aria-labelledby="password-newsletter-title">
        <h2 class="main-password__subtitle" id="password-newsletter-title">{{ 'password.newsletter_title' | t }}</h2>
        {% render 'newsletter-form', id: section.id %}
      </section>
    {%- endif -%}

    <section class="main-password__section" aria-labelledby="password-form-title">
      <h2 class="main-password__subtitle" id="password-form-title">{{ 'password.enter_title' | t }}</h2>
      {%- form 'storefront_password', class: 'main-password__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <label for="password-input">{{ 'password.password_label' | t }}</label>
        <div class="main-password__field">
          <input
            id="password-input"
            type="password"
            name="password"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
          <button type="submit" class="button">{{ 'password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </section>

    <p class="main-password__admin">{{ 'password.admin_link_html' | t }}</p>
  </div>

  <p class="main-password__footer">
    {%- assign current_year = 'now' | date: '%Y' -%}
    {{ 'password.footer' | t: shop: shop.name, year: current_year }}
    {{ powered_by_link }}
  </p>
</div>

{% stylesheet %}
  .main-password {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 1.5rem var(--page-margin);
    background: var(--color-primary);
    color: var(--color-on-primary);
    place-content: center;
    gap: 1rem;
  }

  .main-password__card {
    width: min(100%, 36rem);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    background: var(--color-background);
    color: var(--color-text);
    text-align: center;
  }

  .main-password__title img {
    margin-inline: auto;
  }

  .main-password__message {
    margin-bottom: 1.5rem;
  }

  .main-password__section {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    text-align: start;
  }

  .main-password__subtitle {
    font-size: 1.125rem;
  }

  .main-password__field {
    display: flex;
    gap: 0.5rem;
  }

  .main-password__field input {
    flex: 1;
    min-width: 0;
  }

  .main-password__admin {
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
  }

  .main-password__footer {
    margin: 0;
    font-size: 0.875rem;
    text-align: center;
  }

  .main-password__footer a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.main_password.settings.logo.label",
      "info": "t:sections.main_password.settings.logo.info"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "t:sections.main_password.settings.logo_width",
      "default": 180
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_password.settings.show_newsletter",
      "default": true
    }
  ]
}
{% endschema %}
