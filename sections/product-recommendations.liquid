<product-recommendations
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
  style="
    --section-padding-top: {{ section.settings.padding_top | divided_by: 16.0 }}rem;
    --section-padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.0 }}rem;
    --grid-columns: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: 2;
  "
>
  {%- if recommendations.performed -%}
    {%- if recommendations.products_count > 0 -%}
      <div class="section">
        <div class="page-width">
          {%- if section.settings.heading != blank -%}
            <h2 class="section-heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          <ul class="product-grid" role="list">
            {%- for recommended_product in recommendations.products -%}
              <li>
                {% render 'product-card',
                  product: recommended_product,
                  sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 46vw'
                %}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- elsif request.design_mode -%}
      <div class="section">
        <div class="page-width">
          <p class="product-recommendations__empty">{{ 'products.recommendations.empty_editor' | t }}</p>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</product-recommendations>

<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>

{% stylesheet %}
  product-recommendations {
    display: block;
  }

  .product-recommendations__empty {
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations.settings.heading.label",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.product_recommendations.settings.intent.label",
      "info": "t:sections.product_recommendations.settings.intent.info",
      "options": [
        { "value": "related", "label": "t:sections.product_recommendations.settings.intent.options__1.label" },
        { "value": "complementary", "label": "t:sections.product_recommendations.settings.intent.options__2.label" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_recommendations.settings.products_to_show.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.product_recommendations.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main_product.settings.padding_top.label",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main_product.settings.padding_bottom.label",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_recommendations.name"
    }
  ]
}
{% endschema %}
