{% doc %}
  Renders an inline SVG icon. Icons are decorative unless a label is passed.

  @param {string} name - Icon name
  @param {string} [class] - Extra classes for the svg element
  @param {string} [label] - Accessible label. Leave empty for decorative icons.

  @example
  {% render 'icon', name: 'search' %}
{% enddoc %}

<svg
  class="icon {{ class }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  {% if label != blank %}
    role="img"
    aria-label="{{ label | escape }}"
  {% else %}
    aria-hidden="true"
    focusable="false"
  {% endif %}
>
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'cart' -%}
      <path d="M3 4h2.5l2.2 10.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.8L20 8H6.2"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
    {%- when 'menu' -%}
      <path d="M4 6h16M4 12h16M4 18h16"/>
    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>
    {%- when 'grid' -%}
      <rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/>
    {%- when 'list' -%}
      <path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/>
    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'pause' -%}
      <path d="M8 5v14M16 5v14"/>
    {%- when 'play' -%}
      <path d="M7 5v14l12-7z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>
    {%- when 'gamepad' -%}
      <path d="M7 8h10a4 4 0 0 1 4 4.2l-.4 3.6a2.4 2.4 0 0 1-4.2 1.3L15 15H9l-1.4 2.1a2.4 2.4 0 0 1-4.2-1.3L3 12.200A4 4 0 0 1 7 8z"/><path d="M8 10.500v3M6.500 12h3"/><circle cx="15.500" cy="11" r=".6"/><circle cx="17.500" cy="13" r=".6"/>
    {%- when 'facebook' -%}
      <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.500A.5.5 0 0 1 14 8z"/>
    {%- when 'x' -%}
      <path d="m4 4 16 16M20 4 4 20"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.500"/><circle cx="17" cy="7" r=".6"/>
    {%- when 'youtube' -%}
      <rect x="3" y="6" width="18" height="12" rx="3"/><path d="m10 9.500 5 2.500-5 2.500z"/>
    {%- when 'tiktok' -%}
      <path d="M14 4v10.500a3.500 3.500 0 1 1-3.500-3.500M14 4c.4 2.400 2 4 4.500 4.200"/>
    {%- when 'twitch' -%}
      <path d="M5 3 3 7v13h5v2h3l2-2h4l5-5V3zM11 8v5M16 8v5"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7M7 19.500a1.500 1.500 0 1 0 0-3 1.500 1.500 0 0 0 0 3zM17 19.500a1.500 1.500 0 1 0 0-3 1.500 1.500 0 0 0 0 3z"/>
  {%- endcase -%}
</svg>
