{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "platform": { "type": "platform" },
        "title": { "type": "title" },
        "vendor": { "type": "vendor" },
        "rating": { "type": "rating" },
        "price": { "type": "price", "settings": { "show_tax_note": true } },
        "inventory": { "type": "inventory", "settings": { "low_stock_threshold": 5 } },
        "variant_picker": { "type": "variant_picker", "settings": { "picker_type": "buttons" } },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": true,
            "show_payment_button": true,
            "show_installments": true,
            "show_pickup": true
          }
        },
        "share": { "type": "share" },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping and returns",
            "content": "<p>Add delivery times and return policy details here so shoppers know what to expect before they buy.</p>"
          }
        },
        "specifications": { "type": "specifications", "settings": { "label": "Specifications" } }
      },
      "block_order": [
        "platform",
        "title",
        "vendor",
        "rating",
        "price",
        "inventory",
        "variant_picker",
        "buy_buttons",
        "share",
        "shipping",
        "specifications"
      ],
      "settings": {
        "media_ratio": "square",
        "image_fit": "contain",
        "thumbnail_position": "start",
        "media_width": "medium",
        "show_breadcrumbs": true,
        "show_tabs": true,
        "enable_sticky_bar": true,
        "padding_top": 24,
        "padding_bottom": 32
      }
    },
    "complementary": {
      "type": "product-recommendations",
      "settings": {
        "heading": "Pairs well with",
        "intent": "complementary",
        "products_to_show": 4,
        "columns_desktop": 4,
        "padding_top": 32,
        "padding_bottom": 32
      }
    },
    "related": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "intent": "related",
        "products_to_show": 4,
        "columns_desktop": 4,
        "padding_top": 32,
        "padding_bottom": 32
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_to_show": 4,
        "columns_desktop": 4,
        "padding_top": 32,
        "padding_bottom": 48
      }
    }
  },
  "order": ["main", "complementary", "related", "recently-viewed"]
}
