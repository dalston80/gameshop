{%- paginate blog.articles by 9 -%}
  <div
    class="main-blog section page-width"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <h1 class="main-blog__title section-heading section-heading--start">{{ blog.title | escape }}</h1>

    {%- if section.settings.show_tags_filter and blog.all_tags.size > 0 -%}
      <nav class="main-blog__tags" aria-label="{{ 'blog.general.filter_by_tag' | t }}">
        <ul class="main-blog__tag-list" role="list">
          <li>
            <a
              class="main-blog__tag"
              href="{{ blog.url }}"
              {% if current_tags == blank %}aria-current="page"{% endif %}
            >
              {{- 'blog.general.all' | t -}}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            {%- assign tag_handle = tag | handle -%}
            {%- assign tag_url = blog.url | append: '/tagged/' | append: tag_handle -%}
            <li>
              <a
                class="main-blog__tag"
                href="{{ tag_url }}"
                {% if current_tags contains tag %}aria-current="page"{% endif %}
              >
                {{- tag -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if blog.articles.size == 0 -%}
      <div class="empty-state">
        <p>{{ 'blog.general.empty' | t }}</p>
        <a class="button" href="{{ routes.root_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <ul class="main-blog__grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            {% render 'article-card',
              article: article,
              show_image: section.settings.show_image,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_excerpt: section.settings.show_excerpt,
              eager: forloop.first
            %}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {% render 'content-pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .main-blog__tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .main-blog__tag {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    text-decoration: none;
  }

  .main-blog__tag:hover {
    background: var(--color-soft);
    color: var(--color-on-soft);
  }

  .main-blog__tag[aria-current] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .main-blog__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .main-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    .main-blog__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_blog.settings.show_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.main_blog.settings.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.main_blog.settings.show_author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.main_blog.settings.show_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags_filter",
      "label": "t:sections.main_blog.settings.show_tags_filter",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding_bottom",
      "default": 32
    }
  ]
}
{% endschema %}
