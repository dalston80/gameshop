  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings_schema.typography.heading_font",
        "default": "nunito_sans_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings_schema.typography.body_font",
        "default": "nunito_sans_n4"
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.layout.favicon.label",
        "info": "t:settings_schema.layout.favicon.info"
      },
      {
        "type": "select",
        "id": "page_width",
        "label": "t:settings_schema.layout.page_width.label",
        "options": [
          { "value": "80rem", "label": "t:settings_schema.layout.page_width.narrow" },
          { "value": "90rem", "label": "t:settings_schema.layout.page_width.default" },
          { "value": "110rem", "label": "t:settings_schema.layout.page_width.wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "page_margin",
        "min": 12,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "t:settings_schema.layout.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 16,
        "step": 2,
        "unit": "px",
        "label": "t:settings_schema.layout.corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:settings_schema.product_cards.name",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "t:settings_schema.product_cards.image_ratio.label",
        "options": [
          { "value": "1 / 1", "label": "t:settings_schema.product_cards.image_ratio.square" },
          { "value": "4 / 5", "label": "t:settings_schema.product_cards.image_ratio.portrait" },
          { "value": "3 / 4", "label": "t:settings_schema.product_cards.image_ratio.tall" }
        ],
        "default": "4 / 5"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "t:settings_schema.product_cards.show_vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "t:settings_schema.product_cards.show_rating",
        "info": "t:settings_schema.product_cards.show_rating_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_platform",
        "label": "t:settings_schema.product_cards.show_platform",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "t:settings_schema.product_cards.show_quick_add",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings_schema.cart.type.label",
        "options": [
          { "value": "drawer", "label": "t:settings_schema.cart.type.drawer" },
          { "value": "page", "label": "t:settings_schema.cart.type.page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "t:settings_schema.cart.show_note",
        "default": true
      }
    ]
  },
  {
