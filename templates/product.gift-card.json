{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": { "type": "title" },
        "price": { "type": "price", "settings": { "show_tax_note": true } },
        "variant_picker": { "type": "variant_picker", "settings": { "picker_type": "buttons" } },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": true,
            "show_payment_button": true,
            "show_installments": false,
            "show_pickup": false
          }
        },
        "share": { "type": "share" }
      },
      "block_order": ["title", "price", "variant_picker", "buy_buttons", "share"],
      "settings": {
        "media_ratio": "landscape",
        "image_fit": "contain",
        "thumbnail_position": "bottom",
        "media_width": "medium",
        "show_breadcrumbs": true,
        "show_tabs": true,
        "enable_sticky_bar": false,
        "padding_top": 24,
        "padding_bottom": 32
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_to_show": 4,
        "columns_desktop": 4,
        "padding_top": 32,
        "padding_bottom": 48
      }
    }
  },
  "order": ["main", "recently-viewed"]
}
