{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign total = slides.size
  assign autoplay = false
  if section.settings.autoplay and total > 1
    assign autoplay = true
  endif
  assign speed = section.settings.autoplay_speed | times: 1000
  assign region_label = section.settings.accessibility_label
  if region_label == blank
    assign region_label = 'sections.slideshow.name' | t
  endif
-%}

{%- if total > 0 -%}
  <slide-show
    class="slideshow slideshow--{{ section.settings.height }}"
    data-autoplay="{{ autoplay }}"
    data-speed="{{ speed }}"
    data-label-play="{{ 'sections.slideshow.play' | t | escape }}"
    data-label-pause="{{ 'sections.slideshow.pause' | t | escape }}"
    role="region"
    aria-roledescription="{{ 'sections.slideshow.carousel' | t | escape }}"
    aria-label="{{ region_label | escape }}"
  >
    <div
      class="slideshow__track"
      id="slides-{{ section.id }}"
      data-slideshow-track
      aria-live="off"
    >
      {%- for block in slides -%}
        {%- liquid
          assign image = block.settings.image
          assign overlay = block.settings.overlay_opacity | divided_by: 100.0
          assign slide_label = 'sections.slideshow.slide_of' | t: number: forloop.index, total: total
        -%}
        <div
          class="slideshow__slide slideshow__slide--{{ block.settings.text_alignment }}{% if image == blank %} slideshow__slide--empty{% endif %}"
          role="group"
          aria-roledescription="{{ 'sections.slideshow.slide' | t | escape }}"
          aria-label="{{ slide_label | escape }}"
          data-slide
          {{ block.shopify_attributes }}
        >
          <div class="slideshow__media">
            {%- if image != blank -%}
              {%- assign focal_style = 'object-position: ' | append: image.presentation.focal_point -%}
              {%- if forloop.first -%}
                {{
                  image
                  | image_url: width: 2400
                  | image_tag:
                    widths: '750, 1100, 1500, 1920, 2400',
                    sizes: '100vw',
                    loading: 'eager',
                    fetchpriority: 'high',
                    class: 'slideshow__image',
                    style: focal_style
                }}
              {%- else -%}
                {{
                  image
                  | image_url: width: 2400
                  | image_tag:
                    widths: '750, 1100, 1500, 1920, 2400',
                    sizes: '100vw',
                    loading: 'lazy',
                    class: 'slideshow__image',
                    style: focal_style
                }}
              {%- endif -%}
            {%- elsif request.design_mode -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg slideshow__image' }}
            {%- endif -%}
            {%- if image != blank -%}
              <div class="slideshow__overlay" style="--overlay-opacity: {{ overlay }}"></div>
            {%- endif -%}
          </div>

          {%- if block.settings.heading != blank or block.settings.subtext != blank or block.settings.button_label != blank -%}
            <div class="slideshow__content page-width">
              <div class="slideshow__text">
                {%- if block.settings.heading != blank -%}
                  <h2 class="slideshow__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <p class="slideshow__subtext">{{ block.settings.subtext | escape }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if total > 1 -%}
      <div class="slideshow__controls">
        <button
          type="button"
          class="carousel-button slideshow__arrow slideshow__arrow--previous"
          data-slideshow-previous
          aria-controls="slides-{{ section.id }}"
        >
          {% render 'icon', name: 'chevron-left' %}
          <span class="visually-hidden">{{ 'sections.slideshow.previous' | t }}</span>
        </button>

        <div class="slideshow__nav">
          {%- if autoplay -%}
            <button
              type="button"
              class="slideshow__toggle"
              data-slideshow-toggle
              aria-controls="slides-{{ section.id }}"
              aria-label="{{ 'sections.slideshow.pause' | t }}"
            >
              {% render 'icon', name: 'pause', class: 'icon--small slideshow__icon-pause' %}
              {% render 'icon', name: 'play', class: 'icon--small slideshow__icon-play' %}
            </button>
          {%- endif -%}
          <div class="slideshow__dots">
            {%- for block in slides -%}
              <button
                type="button"
                class="slideshow__dot"
                data-slideshow-dot
                aria-controls="slides-{{ section.id }}"
                aria-label="{{ 'sections.slideshow.go_to' | t: number: forloop.index }}"
                {% if forloop.first %}
                  aria-current="true"
                {% endif %}
              ></button>
            {%- endfor -%}
          </div>
        </div>

        <button
          type="button"
          class="carousel-button slideshow__arrow slideshow__arrow--next"
          data-slideshow-next
          aria-controls="slides-{{ section.id }}"
        >
          {% render 'icon', name: 'chevron-right' %}
          <span class="visually-hidden">{{ 'sections.slideshow.next' | t }}</span>
        </button>
      </div>
    {%- endif -%}
  </slide-show>

  <script src="{{ 'slideshow.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <div class="page-width section">
    <div class="empty-state">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      <p>{{ 'sections.slideshow.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .slideshow {
    position: relative;
    display: block;
    --slideshow-height: 28rem;
  }

  .slideshow--small {
    --slideshow-height: 20rem;
  }

  .slideshow--large {
    --slideshow-height: 36rem;
  }

  .slideshow__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .slideshow__track::-webkit-scrollbar {
    display: none;
  }

  .slideshow__slide {
    position: relative;
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    min-height: min(var(--slideshow-height), 28rem);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: var(--color-primary);
    color: #fff;
  }

  .slideshow__slide--empty {
    color: var(--color-on-primary);
  }

  @media (min-width: 750px) {
    .slideshow__slide {
      min-height: var(--slideshow-height);
    }
  }

  .slideshow__media {
    position: absolute;
    inset: 0;
  }

  .slideshow__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slideshow__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--overlay-opacity, 0.5));
  }

  .slideshow__content {
    position: relative;
    z-index: 1;
    padding-block: 4.5rem;
  }

  .slideshow__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 38rem;
  }

  .slideshow__slide--center .slideshow__text {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .slideshow__slide--right .slideshow__text {
    align-items: flex-end;
    margin-inline-start: auto;
    text-align: end;
  }

  .slideshow__heading {
    margin: 0;
    font-size: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
  }

  .slideshow__subtext {
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
    font-weight: var(--font-body-weight-bold);
  }

  .slideshow__controls {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .slideshow__controls > * {
    pointer-events: auto;
  }

  .slideshow__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .slideshow__arrow--previous {
    inset-inline-start: 0.5rem;
  }

  .slideshow__arrow--next {
    inset-inline-end: 0.5rem;
  }

  [dir='rtl'] .slideshow__arrow .icon {
    transform: scaleX(-1);
  }

  @media (min-width: 750px) {
    .slideshow__arrow--previous {
      inset-inline-start: 1.5rem;
    }

    .slideshow__arrow--next {
      inset-inline-end: 1.5rem;
    }
  }

  .slideshow__nav {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transform: translateX(-50%);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
  }

  .slideshow__dots {
    display: flex;
  }

  .slideshow__dot,
  .slideshow__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .slideshow__icon-play,
  .slideshow__toggle[data-state='paused'] .slideshow__icon-pause {
    display: none;
  }

  .slideshow__toggle[data-state='paused'] .slideshow__icon-play {
    display: block;
  }

  .slideshow__dot::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid #fff;
    border-radius: 50%;
  }

  .slideshow__dot[aria-current='true']::before {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section-slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.slideshow.settings.height.label",
      "options": [
        { "value": "small", "label": "t:sections.slideshow.settings.height.small" },
        { "value": "medium", "label": "t:sections.slideshow.settings.height.medium" },
        { "value": "large", "label": "t:sections.slideshow.settings.height.large" }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "t:sections.slideshow.settings.accessibility_label.label",
      "info": "t:sections.slideshow.settings.accessibility_label.info"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header_autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.settings.autoplay.label",
      "info": "t:sections.slideshow.settings.autoplay.info",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.slideshow.settings.autoplay_speed.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label",
          "default": "New releases are here"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "t:sections.slideshow.blocks.slide.settings.subtext.label",
          "default": "Pre-order the games you have been waiting for"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.slideshow.blocks.slide.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.label",
          "options": [
            { "value": "left", "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.left" },
            { "value": "center", "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.center" },
            { "value": "right", "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:sections.slideshow.blocks.slide.settings.overlay_opacity.label",
          "info": "t:sections.slideshow.blocks.slide.settings.overlay_opacity.info",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 55
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets.name",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
