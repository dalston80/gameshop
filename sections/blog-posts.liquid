{%- liquid
  assign blog = blogs[section.settings.blog]
  assign articles = blog.articles
  assign limit = section.settings.post_limit
-%}

{%- if blog != blank and articles.size > 0 -%}
  <div
    class="section blog-posts"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="blog-posts__list" role="list">
        {%- for article in articles limit: limit -%}
          <li class="blog-posts__item">
            <article class="blog-posts__card">
              {%- if article.image -%}
                <a class="blog-posts__media media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      widths: '300, 400, 600, 800',
                      sizes: '(min-width: 990px) 380px, (min-width: 750px) 30vw, 92vw',
                      loading: 'lazy',
                      alt: ''
                  }}
                </a>
              {%- endif -%}
              <h3 class="blog-posts__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>
              {%- if section.settings.show_date -%}
                <time class="blog-posts__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{- article.published_at | date: format: 'date' -}}
                </time>
              {%- endif -%}
              {%- if section.settings.show_excerpt -%}
                <p class="blog-posts__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section">
    <div class="empty-state">
      <p>{{ 'sections.blog_posts.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .blog-posts__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-posts__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .blog-posts__media {
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
  }

  .blog-posts__title {
    margin: 0.5rem 0 0;
    font-size: 1.125rem;
  }

  .blog-posts__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .blog-posts__title a:hover {
    text-decoration: underline;
  }

  .blog-posts__date {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .blog-posts__excerpt {
    margin: 0;
  }

  @media (min-width: 750px) {
    .blog-posts__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "tag": "section",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.blog_posts.settings.heading.label",
      "default": "GameShop News"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_posts.settings.blog.label"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "t:sections.blog_posts.settings.post_limit.label",
      "min": 3,
      "max": 6,
      "step": 3,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.blog_posts.settings.show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog_posts.settings.show_excerpt.label",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.marketing.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.marketing.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.presets.name"
    }
  ]
}
{% endschema %}
