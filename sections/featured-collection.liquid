{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign limit = section.settings.products_to_show
  assign heading_id = 'heading-' | append: section.id
-%}

<div
  class="section featured-collection"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --carousel-columns: {{ section.settings.columns_desktop }};"
>
  <div class="page-width">
    {%- if heading != blank or section.settings.show_view_all and collection != blank -%}
      <div class="section-header featured-collection__header">
        {%- if heading != blank -%}
          <h2 class="section-heading featured-collection__heading" id="{{ heading_id }}">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_view_all and collection != blank -%}
          <a class="featured-collection__view-all" href="{{ collection.url }}">
            {{- 'sections.featured_collection.view_all' | t -}}
            {%- if heading != blank -%}
              <span class="visually-hidden"> {{ heading | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <scroll-carousel class="featured-collection__carousel">
        <button
          type="button"
          class="carousel-button featured-collection__arrow featured-collection__arrow--previous"
          data-carousel-previous
          aria-controls="products-{{ section.id }}"
        >
          {% render 'icon', name: 'chevron-left' %}
          <span class="visually-hidden">{{ 'sections.featured_collection.previous' | t }}</span>
        </button>

        <ul
          class="featured-collection__track"
          id="products-{{ section.id }}"
          role="list"
          data-carousel-track
          {% if heading != blank %}
            aria-labelledby="{{ heading_id }}"
          {% endif %}
        >
          {%- for product in collection.products limit: limit -%}
            <li class="featured-collection__item">
              {% render 'product-card', product: product %}
            </li>
          {%- endfor -%}
        </ul>

        <button
          type="button"
          class="carousel-button featured-collection__arrow featured-collection__arrow--next"
          data-carousel-next
          aria-controls="products-{{ section.id }}"
        >
          {% render 'icon', name: 'chevron-right' %}
          <span class="visually-hidden">{{ 'sections.featured_collection.next' | t }}</span>
        </button>
      </scroll-carousel>
    {%- elsif request.design_mode -%}
      <ul class="featured-collection__track featured-collection__track--placeholder" role="list">
        {%- for i in (1..4) -%}
          <li class="featured-collection__item">
            <div class="media featured-collection__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <p class="featured-collection__message">{{ 'sections.featured_collection.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .featured-collection__view-all {
    flex: none;
    color: var(--color-accent-text);
    font-weight: var(--font-body-weight-bold);
  }

  .featured-collection__carousel {
    position: relative;
    display: block;
  }

  .featured-collection__track {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0.25rem 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .featured-collection__track::-webkit-scrollbar {
    display: none;
  }

  .featured-collection__item {
    flex: 0 0 calc((100% - 0.75rem) / 2);
    min-width: 0;
    scroll-snap-align: start;
  }

  .featured-collection__arrow {
    position: absolute;
    top: 40%;
    z-index: 1;
    display: none;
  }

  .featured-collection__arrow--previous {
    inset-inline-start: -1.375rem;
  }

  .featured-collection__arrow--next {
    inset-inline-end: -1.375rem;
  }

  [dir='rtl'] .featured-collection__arrow .icon {
    transform: scaleX(-1);
  }

  .featured-collection__track--placeholder .featured-collection__placeholder {
    aspect-ratio: var(--card-image-ratio);
  }

  .featured-collection__message {
    margin: 1rem 0 0;
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (min-width: 750px) {
    .featured-collection__track {
      gap: 1.5rem;
    }

    .featured-collection__item {
      flex-basis: calc((100% - 1.5rem * (var(--carousel-columns, 4) - 1)) / var(--carousel-columns, 4));
    }

    .featured-collection__carousel.is-scrollable .featured-collection__arrow {
      display: inline-flex;
    }
  }

  @media (min-width: 750px) and (max-width: 1100px) {
    .featured-collection__carousel.is-scrollable .featured-collection__arrow--previous {
      inset-inline-start: 0.25rem;
    }

    .featured-collection__carousel.is-scrollable .featured-collection__arrow--next {
      inset-inline-end: 0.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.featured_collection.settings.columns_desktop.label",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.marketing.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.marketing.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.name"
    }
  ]
}
{% endschema %}
