<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {% unless settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    {%- capture platform_selected_template -%}
      {{- 'general.platform.selected' | t: platform: '__PLATFORM__' -}}
    {%- endcapture -%}
    <script>
      window.theme = {
        cartType: {{ settings.cart_type | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cart_add: {{ routes.cart_add_url | json }},
          cart_change: {{ routes.cart_change_url | json }},
          cart_update: {{ routes.cart_update_url | json }},
          predictive_search: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }}
        },
        strings: {
          added_to_cart: {{ 'products.product.added_to_cart' | t | json }},
          cart_error: {{ 'cart.general.error' | t | json }},
          platform_selected: {{ platform_selected_template | json }},
          platform_cleared: {{ 'general.platform.cleared' | t | json }}
        }
      };
    </script>
    {%- if settings.enable_my_platform -%}
      <script>
        try {
          var gsPlatform = localStorage.getItem('gs-platform');
          if (gsPlatform) document.documentElement.setAttribute('data-my-platform', gsPlatform);
        } catch (error) {}
      </script>
      <script src="{{ 'platform.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'global.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#main-content">{{ 'general.accessibility.skip_to_content' | t }}</a>
    <div class="visually-hidden" role="status" aria-live="polite" data-live-region></div>

    {% sections 'header-group' %}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.cart_type == 'drawer' and request.page_type != 'cart' %}
      {% section 'cart-drawer' %}
    {% endif %}
  </body>
</html>
