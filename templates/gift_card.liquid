{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'gift-card.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'gift-card.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="gift-card-page">
    <main class="gift-card" id="main-content">
      <header class="gift-card__brand">
        {%- if shop.brand.logo != blank -%}
          {{
            shop.brand.logo
            | image_url: width: 400
            | image_tag: width: 200, loading: 'eager', alt: shop.name, class: 'gift-card__logo'
          }}
        {%- else -%}
          <p class="gift-card__shop-name">{{ shop.name }}</p>
        {%- endif -%}
      </header>

      <h1 class="gift-card__title">{{ 'gift_card.title' | t }}</h1>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="form-message form-message--error" role="status">
          {%- if gift_card.expired -%}
            {{ 'gift_card.expired' | t }}
          {%- else -%}
            {{ 'gift_card.disabled' | t }}
          {%- endif -%}
        </p>
      {%- endif -%}

      <section class="gift-card__card" aria-label="{{ 'gift_card.card' | t }}">
        <p class="gift-card__balance-label">{{ 'gift_card.remaining_balance' | t }}</p>
        <p class="gift-card__balance">{{ gift_card.balance | money }}</p>

        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial_amount = gift_card.initial_value | money -%}
          <p class="gift-card__initial">{{ 'gift_card.initial_value' | t: amount: initial_amount }}</p>
        {%- endif -%}

        <p class="gift-card__code-label" id="gift-card-code-label">{{ 'gift_card.code' | t }}</p>
        <p class="gift-card__code" aria-labelledby="gift-card-code-label">
          <strong>{{ gift_card.code | format_code }}</strong>
        </p>

        {%- if gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="gift-card__expiry">
            {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
          </p>
        {%- endif -%}
      </section>

      <div class="gift-card__qr">
        <div
          id="qr-code"
          class="gift-card__qr-code"
          data-qr-text="{{ gift_card.qr_identifier }}"
          role="img"
          aria-label="{{ 'gift_card.qr_label' | t }}"
        ></div>
        <p class="gift-card__hint">{{ 'gift_card.qr_hint' | t }}</p>
      </div>

      <div class="gift-card__actions">
        <a class="button" href="{{ shop.url }}">{{ 'gift_card.use_at_checkout' | t }}</a>
        <button type="button" class="button button--secondary" data-print hidden>{{ 'gift_card.print' | t }}</button>
        {%- if gift_card.pass_url -%}
          <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              width="120"
              height="40"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      </div>
    </main>
  </body>
</html>
