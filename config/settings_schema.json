      { "type": "text", "id": "social_x", "label": "X" },
      { "type": "text", "id": "social_instagram", "label": "Instagram" },
      { "type": "text", "id": "social_youtube", "label": "YouTube" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok" },
      { "type": "text", "id": "social_twitch", "label": "Twitch" }
    ]
  },
  {
    "name": "t:settings_schema.search.name",
    "settings": [
      {
        "type": "range",
        "id": "predictive_search_limit",
        "min": 2,
        "max": 8,
        "step": 1,
        "label": "t:settings_schema.search.predictive_limit",
        "default": 4
