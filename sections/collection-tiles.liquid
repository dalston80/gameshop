{%- assign tiles = section.blocks | where: 'type', 'tile' -%}

{%- if tiles.size > 0 -%}
  <div class="section collection-tiles" style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="page-width">
      <ul class="collection-tiles__grid" role="list">
        {%- for block in tiles -%}
          {%- liquid
            assign collection = block.settings.collection
            assign image = block.settings.image
            if image == blank
              assign image = collection.featured_image
            endif
            assign heading = block.settings.heading
            if heading == blank and collection != blank
              assign heading = 'sections.collection_tiles.shop' | t: title: collection.title
            endif
            assign tile_url = collection.url
          -%}
          {%- if tile_url != blank or request.design_mode -%}
            <li class="collection-tiles__item" {{ block.shopify_attributes }}>
              <a
                class="collection-tiles__tile{% if image == blank %} collection-tiles__tile--empty{% endif %}"
                {% if tile_url != blank %}
                  href="{{ tile_url }}"
                {% endif %}
              >
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: 1000
                    | image_tag:
                      widths: '400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 560px, 50vw',
                      loading: 'lazy',
                      class: 'collection-tiles__image',
                      alt: ''
                  }}
                  <span class="collection-tiles__scrim"></span>
                {%- elsif request.design_mode -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collection-tiles__image' }}
                {%- endif -%}
                <span class="collection-tiles__heading">
                  {%- if heading != blank -%}
                    {{- heading | escape -}}
                  {%- else -%}
                    {{- 'sections.collection_tiles.choose' | t -}}
                  {%- endif -%}
                </span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section">
    <div class="empty-state">
      <p>{{ 'sections.collection_tiles.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-tiles__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-tiles__tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
    text-align: center;
    text-decoration: none;
  }

  .collection-tiles__tile--empty {
    color: var(--color-on-primary);
  }

  .collection-tiles__tile:hover .collection-tiles__image {
    transform: scale(1.03);
  }

  .collection-tiles__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collection-tiles__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
  }

  .collection-tiles__heading {
    position: relative;
    padding: 1rem;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    font-weight: var(--font-heading-weight);
    line-height: 1.2;
  }

  @media (min-width: 750px) {
    .collection-tiles__grid {
      gap: 1rem;
    }

    .collection-tiles__tile {
      aspect-ratio: 2.4 / 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_tiles.name",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.marketing.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.marketing.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:sections.collection_tiles.blocks.tile.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_tiles.blocks.tile.settings.collection.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.collection_tiles.blocks.tile.settings.heading.label",
          "info": "t:sections.collection_tiles.blocks.tile.settings.heading.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_tiles.blocks.tile.settings.image.label",
          "info": "t:sections.collection_tiles.blocks.tile.settings.image.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_tiles.presets.name",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
