{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id

  assign ratio = '1 / 1'
  if section.settings.media_ratio == 'landscape'
    assign ratio = '4 / 3'
  elsif section.settings.media_ratio == 'portrait'
    assign ratio = '3 / 4'
  endif

  assign media_columns = 'minmax(0, 1.15fr) minmax(0, 1fr)'
  if section.settings.media_width == 'small'
    assign media_columns = 'minmax(0, 1fr) minmax(0, 1fr)'
  elsif section.settings.media_width == 'large'
    assign media_columns = 'minmax(0, 1.4fr) minmax(0, 1fr)'
  endif

  assign has_reviews_area = false
  assign reached_marker = false
  for block in section.blocks
    if block.type == 'app_reviews_marker'
      assign reached_marker = true
    elsif block.type == 'specifications'
      assign specifications_block = block
    elsif reached_marker
      assign has_reviews_area = true
    endif
  endfor

  assign has_overview = false
  if product.description != blank
    assign has_overview = true
  endif

  assign has_specifications = false
  assign specifications_content = specifications_block.settings.content
  if product.metafields.custom.specifications != blank or specifications_content != blank
    assign has_specifications = true
  endif

  assign specifications_label = specifications_block.settings.label
  if specifications_label == blank
    assign specifications_label = 'products.tabs.specifications' | t
  endif

  assign tab_count = 0
  if has_overview and section.settings.show_tabs
    assign tab_count = tab_count | plus: 1
  endif
  if has_specifications and section.settings.show_tabs
    assign tab_count = tab_count | plus: 1
  endif
  if has_reviews_area
    assign tab_count = tab_count | plus: 1
  endif
-%}

<section
  class="main-product section"
  data-product-section
  style="
    --section-padding-top: {{ section.settings.padding_top | divided_by: 16.0 }}rem;
    --section-padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.0 }}rem;
    --gallery-ratio: {{ ratio }};
    --gallery-fit: {{ section.settings.image_fit }};
    --media-columns: {{ media_columns }};
  "
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      <div class="main-product__breadcrumbs">
        {% render 'breadcrumbs',
          type: 'product',
          product: product,
          collection: collection,
          menu: section.settings.breadcrumb_menu
        %}
      </div>
    {%- endif -%}

    <div class="main-product__layout">
      <div class="main-product__media">
        {% render 'product-gallery',
          product: product,
          section_id: section.id,
          selected_media: current_variant.featured_media,
          thumbnails: section.settings.thumbnail_position
        %}
      </div>

      <product-form
        class="main-product__info"
        data-section-id="{{ section.id }}"
        data-url="{{ product.url }}"
        data-update-url="true"
      >
        {% render 'product-blocks',
          product: product,
          variant: current_variant,
          blocks: section.blocks,
          section_id: section.id,
          area: 'info',
          heading_tag: 'h1',
          has_reviews_area: has_reviews_area
        %}

        {%- if section.settings.enable_sticky_bar -%}
          <div class="main-product__sticky-bar" data-sticky-bar hidden>
            <div class="main-product__sticky-info">
              <p class="main-product__sticky-title">{{ product.title }}</p>
              <div data-update="sticky-price">
                {% render 'price', product: product, variant: current_variant %}
              </div>
            </div>
            <div data-update="sticky-submit">
              <button
                type="submit"
                form="{{ form_id }}"
                class="button"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>
          </div>
        {%- endif -%}
      </product-form>
    </div>

    {%- if tab_count > 0 -%}
      <product-tabs class="main-product__tabs">
        {%- if tab_count > 1 -%}
          <div
            class="main-product__tab-list"
            role="tablist"
            aria-label="{{ 'products.tabs.label' | t }}"
            data-tab-list
            hidden
          >
            {%- if has_overview and section.settings.show_tabs -%}
              <button
                type="button"
                class="main-product__tab"
                role="tab"
                id="{{ section.id }}-tab-overview"
                aria-controls="{{ section.id }}-panel-overview"
                aria-selected="true"
              >
                {{ 'products.tabs.overview' | t }}
              </button>
            {%- endif -%}
            {%- if has_specifications and section.settings.show_tabs -%}
              <button
                type="button"
                class="main-product__tab"
                role="tab"
                id="{{ section.id }}-tab-specifications"
                aria-controls="{{ section.id }}-panel-specifications"
                aria-selected="false"
                tabindex="-1"
              >
                {{ specifications_label }}
              </button>
            {%- endif -%}
            {%- if has_reviews_area -%}
              <button
                type="button"
                class="main-product__tab"
                role="tab"
                id="{{ section.id }}-tab-reviews"
                aria-controls="reviews"
                aria-selected="false"
                tabindex="-1"
              >
                {{ 'products.tabs.reviews' | t }}
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if has_overview and section.settings.show_tabs -%}
          <div
            class="main-product__panel"
            role="{% if tab_count > 1 %}tabpanel{% else %}region{% endif %}"
            id="{{ section.id }}-panel-overview"
            aria-labelledby="{{ section.id }}-{% if tab_count > 1 %}tab-overview{% else %}heading-overview{% endif %}"
          >
            {%- if tab_count == 1 -%}
              <h2 id="{{ section.id }}-heading-overview">{{ 'products.tabs.overview' | t }}</h2>
            {%- endif -%}
            <div class="rte">{{ product.description }}</div>
          </div>
        {%- endif -%}

        {%- if has_specifications and section.settings.show_tabs -%}
          <div
            class="main-product__panel"
            role="{% if tab_count > 1 %}tabpanel{% else %}region{% endif %}"
            id="{{ section.id }}-panel-specifications"
            aria-labelledby="{{ section.id }}-{% if tab_count > 1 %}tab-specifications{% else %}heading-specifications{% endif %}"
            {% if tab_count > 1 %}
              hidden
            {% endif %}
            {{ specifications_block.shopify_attributes }}
          >
            {%- if tab_count == 1 -%}
              <h2 id="{{ section.id }}-heading-specifications">
                {{- specifications_label -}}
              </h2>
            {%- endif -%}
            <div class="rte">
              {%- if product.metafields.custom.specifications != blank -%}
                {{ product.metafields.custom.specifications | metafield_tag }}
              {%- else -%}
                {{ specifications_content }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if has_reviews_area -%}
          <div
            class="main-product__panel"
            role="{% if tab_count > 1 %}tabpanel{% else %}region{% endif %}"
            id="reviews"
            aria-labelledby="{{ section.id }}-{% if tab_count > 1 %}tab-reviews{% else %}heading-reviews{% endif %}"
            {% if tab_count > 1 %}
              hidden
            {% endif %}
          >
            {%- if tab_count == 1 -%}
              <h2 id="{{ section.id }}-heading-reviews">{{ 'products.tabs.reviews' | t }}</h2>
            {%- endif -%}
            {% render 'product-blocks',
              product: product,
              variant: current_variant,
              blocks: section.blocks,
              section_id: section.id,
              area: 'reviews'
            %}
          </div>
        {%- endif -%}
      </product-tabs>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>
<script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
<recently-viewed-tracker data-handle="{{ product.handle }}"></recently-viewed-tracker>

{% stylesheet %}
  .main-product__breadcrumbs {
    margin-bottom: 1rem;
  }

  .main-product__layout {
    display: grid;
    gap: 1.5rem;
  }

  .main-product__media,
  .main-product__info {
    min-width: 0;
  }

  @media (min-width: 990px) {
    .main-product__layout {
      grid-template-columns: var(--media-columns);
      gap: 3rem;
      align-items: start;
    }

    .main-product__media {
      position: sticky;
      top: 1.5rem;
    }
  }

  .main-product__tabs {
    display: block;
    margin-top: 3rem;
  }

  .main-product__tab-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .main-product__tab {
    min-height: 2.75rem;
    margin-bottom: -1px;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 3px solid transparent;
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: 1.125rem;
    font-weight: var(--font-body-weight-bold);
    cursor: pointer;
  }

  .main-product__tab[aria-selected='true'] {
    border-bottom-color: var(--color-accent-text);
    color: var(--color-accent-text);
  }

  .main-product__panel + .main-product__panel {
    margin-top: 2rem;
  }

  .main-product__panel[hidden] {
    display: none;
  }

  .main-product__sticky-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem var(--page-margin);
    border-top: 1px solid var(--color-border);
    background: var(--color-background);
    box-shadow: 0 -4px 12px rgb(0 0 0 / 0.08);
  }

  .main-product__sticky-bar[hidden] {
    display: none;
  }

  .main-product__sticky-info {
    min-width: 0;
  }

  .main-product__sticky-title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: var(--font-body-weight-bold);
    line-height: 1.3;
  }

  @media (min-width: 750px) {
    .main-product__sticky-bar {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
