<div
  class="section rich-text"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="rich-text__content rich-text__content--{{ section.settings.alignment }} rich-text__content--{{ section.settings.width }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="rich-text__heading" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rich-text__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}
          {%- when 'button' -%}
            {%- if block.settings.label != blank and block.settings.link != blank -%}
              <a
                class="button{% if block.settings.style == 'secondary' %} button--secondary{% endif %}"
                href="{{ block.settings.link }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | escape -}}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .rich-text__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-inline: auto;
  }

  .rich-text__content--narrow {
    max-width: 40rem;
  }

  .rich-text__content--medium {
    max-width: 56rem;
  }

  .rich-text__content--left {
    align-items: flex-start;
    text-align: start;
  }

  .rich-text__content--center {
    align-items: center;
    text-align: center;
  }

  .rich-text__heading,
  .rich-text__text > :first-child,
  .rich-text__text > :last-child {
    margin-block: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.rich_text.settings.alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.rich_text.settings.alignment.left" },
        { "value": "center", "label": "t:sections.rich_text.settings.alignment.center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.rich_text.settings.width.label",
      "options": [
        { "value": "narrow", "label": "t:sections.rich_text.settings.width.narrow" },
        { "value": "medium", "label": "t:sections.rich_text.settings.width.medium" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.marketing.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.marketing.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich_text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.rich_text.blocks.heading.settings.heading.label",
          "default": "Talk about your store"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich_text.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.rich_text.blocks.text.settings.text.label",
          "default": "<p>Share news, tell your story or explain what makes your store special.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich_text.blocks.button.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.rich_text.blocks.button.settings.label.label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.rich_text.blocks.button.settings.link.label"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.rich_text.blocks.button.settings.style.label",
          "options": [
            { "value": "primary", "label": "t:sections.rich_text.blocks.button.settings.style.primary" },
            { "value": "secondary", "label": "t:sections.rich_text.blocks.button.settings.style.secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.presets.name",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
