<recently-viewed
  class="recently-viewed"
  data-current-handle="{{ product.handle }}"
  data-limit="{{ section.settings.products_to_show }}"
  data-root="{{ routes.root_url }}"
  style="
    --section-padding-top: {{ section.settings.padding_top | divided_by: 16.0 }}rem;
    --section-padding-bottom: {{ section.settings.padding_bottom | divided_by: 16.0 }}rem;
    --grid-columns: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: 2;
  "
  hidden
>
  <div class="section">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <ul class="product-grid" role="list" data-recently-viewed-list></ul>
      {%- if request.design_mode -%}
        <p class="recently-viewed__empty" data-recently-viewed-placeholder hidden>
          {{ 'products.recently_viewed.empty_editor' | t }}
        </p>
      {%- endif -%}
    </div>
  </div>
</recently-viewed>

<script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>

{% stylesheet %}
  recently-viewed {
    display: block;
  }

  recently-viewed[hidden] {
    display: none;
  }

  .recently-viewed__empty {
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.recently_viewed.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.recently_viewed.settings.heading.label",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.recently_viewed.settings.products_to_show.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.product_recommendations.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main_product.settings.padding_top.label",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main_product.settings.padding_bottom.label",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.recently_viewed.name"
    }
  ]
}
{% endschema %}
